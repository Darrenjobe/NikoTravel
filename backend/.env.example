# Copy to .env for local dev (uvicorn app.main:app --reload from backend/)
# Generate the token: openssl rand -hex 32
API_TOKEN=

# LLM — Anthropic is the default provider
ANTHROPIC_API_KEY=
# Optional fallback provider (set LLM_PROVIDER=openai to use it)
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# Fallbacks only — a choice made via POST /api/models is stored in SQLite and
# overrides these. Default is claude-sonnet-5 for both.
# CHAT_MODEL=claude-sonnet-5    # claude-opus-5 for depth, claude-haiku-4-5 for speed
# JOB_MODEL=claude-sonnet-5

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# Tavily — free tier at tavily.com
TAVILY_API_KEY=

TRIP_YEAR=2026
