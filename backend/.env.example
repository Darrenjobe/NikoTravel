# Copy to .env for local dev (uvicorn app.main:app --reload from backend/)
# Generate the token: openssl rand -hex 32
API_TOKEN=

# LLM — Anthropic is the default provider
ANTHROPIC_API_KEY=
# Optional fallback provider (set LLM_PROVIDER=openai to use it)
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# Fallbacks only — a choice made via POST /api/models is stored in SQLite and
# overrides these. Default is claude-sonnet-5 for both.
# CHAT_MODEL=claude-sonnet-5    # claude-opus-5 for depth, claude-haiku-4-5 for speed
# JOB_MODEL=claude-sonnet-5

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# ElevenLabs text to speech. Without a key /api/tts returns 503; everything
# else works unchanged.
ELEVENLABS_API_KEY=
# The 20-char id is the VOICE; the model is a slug. They are not the same
# field — sending a voice id as model_id is rejected by the API.
# TTS_VOICE_ID=QnPbsq4pmOZkrE4RQQCA    # Greek speaker, handles English too
# TTS_MODEL=eleven_flash_v2_5
# TTS_OUTPUT_FORMAT=mp3_44100_128      # mp3_22050_32 is ~4x smaller over eSIM
# TTS_CACHE_MB=500
# TTS_MAX_CHARS=5000

# Tavily — free tier at tavily.com
TAVILY_API_KEY=

TRIP_YEAR=2026
