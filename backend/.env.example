# Copy to .env for local dev (uvicorn app.main:app --reload from backend/)
# Generate the token: openssl rand -hex 32
API_TOKEN=

# LLM — Anthropic is the default provider
ANTHROPIC_API_KEY=
# Optional fallback provider (set LLM_PROVIDER=openai to use it)
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# CHAT_MODEL=claude-opus-5      # drop to claude-haiku-4-5 for lower latency
# JOB_MODEL=claude-opus-5

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# Tavily — free tier at tavily.com
TAVILY_API_KEY=

TRIP_YEAR=2026
